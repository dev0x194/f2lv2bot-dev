# ==============================================================================
# FileToLinkV2bot - ISOLATED DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to 'dev.env' for local development:
#   cp dev.env.example dev.env
#
# To start the development stack:
#   docker compose -f docker-compose.dev.yml --env-file dev.env up -d --build
#
# CRITICAL PRODUCTION SAFETY NOTICE:
#   - NEVER copy production secrets, production bot tokens, or production
#     database URLs into this file or dev.env.
#   - This development environment runs completely isolated from production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Compose Metadata
# ------------------------------------------------------------------------------
APP_ENV=development
ENVIRONMENT=development
DEBUG=True
COMPOSE_PROJECT_NAME=filetolinkv2bot-dev
FILESTREAM_DEV_IMAGE=filestreambot:dev

# ------------------------------------------------------------------------------
# 2. Telegram Credentials (MUST BE SEPARATE DEV BOT)
# ------------------------------------------------------------------------------
# Create a dedicated testing bot with @BotFather for development/testing.
# DO NOT REUSE THE PRODUCTION BOT TOKEN!
API_ID=REPLACE_WITH_DEV_API_ID
API_HASH=REPLACE_WITH_DEV_API_HASH
BOT_TOKEN=REPLACE_WITH_DEV_BOT_TOKEN
OWNER_ID=REPLACE_WITH_DEV_OWNER_ID

# ------------------------------------------------------------------------------
# 3. Session & Database Isolation
# ------------------------------------------------------------------------------
# Distinct session name ensures Pyrogram session file does not collide with production.
SESSION_NAME=FileStreamDev
SESSION_DIR=/app/sessions

# MongoDB Connection String (e.g. MongoDB Atlas cluster or external MongoDB instance).
# The database name used inside the cluster will automatically correspond to SESSION_NAME (FileStreamDev).
DATABASE_URL=mongodb+srv://dev0x194_db_user:o9uEtQrqSpXrfDFw@cluster0.fvxum3x.mongodb.net/?appName=Cluster0

# ------------------------------------------------------------------------------
# 4. Server & Port Isolation
# ------------------------------------------------------------------------------
# Internal container port (must be 8081 for DEV):
PORT=8081
# Host port exposed by Docker: access web UI at http://<vps-ip>:8081 or http://localhost:8081
# Ensure this does not collide with production (80, 443, 8080).
DEV_HOST_PORT=8081
BIND_ADDRESS=0.0.0.0
# Public or direct IP for generated links:
FQDN=127.0.0.1
HAS_SSL=False
NO_PORT=False
PING_INTERVAL=1200
WORKERS=4
SLEEP_THRESHOLD=60
PUBLIC_FILE_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 5. Dedicated Dev Volumes & Cache Isolation
# ------------------------------------------------------------------------------
DEV_NETWORK=filestreambot-dev-network
DEV_CACHE_VOLUME=filestream_cache_dev
DEV_SESSIONS_VOLUME=filestream_sessions_dev

STREAM_CACHE_DIR=/tmp/filestream_dev_stream_cache
STREAM_LOCAL_CACHE_ENABLED=True
STREAM_CACHE_MAX_GB=2
STREAM_CACHE_TTL_HOURS=6
NUDENET_TEMP_DIR=/tmp/filestream_dev_nsfw
NUDENET_ENABLE=False

# Dedicated log file path (avoids collision with streambot.log)
STREAMBOT_LOG_PATH=/app/streambot_dev.log

# ------------------------------------------------------------------------------
# 6. Channels (Optional for development testing)
# ------------------------------------------------------------------------------
# Use separate dev/test channels or leave empty for basic features.
FLOG_CHANNEL=
ADMIN_FLOG_CHANNEL=
ULOG_CHANNEL=
BIN_CHANNEL=
NUDENET_CHANNEL=

# Force-subscribe options (disabled in dev)
FORCE_SUB=False
UPDATES_CHANNEL=

# ------------------------------------------------------------------------------
# 7. Web Ads & Monetization (Disabled in dev)
# ------------------------------------------------------------------------------
WEB_ADS_ENABLED=False
